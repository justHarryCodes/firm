# EmailJS — used for the contact form. Obtain these from https://dashboard.emailjs.com/admin
# Account > API Keys reveals your Public Key. Email Services and Email Templates
# reveal the Service ID and Template ID respectively.
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Tawk.to — optional live chat widget. From the Tawk.to dashboard, open your property
# and locate Property ID and Widget ID (default widget id is "default").
VITE_TAWK_PROPERTY_ID=
VITE_TAWK_WIDGET_ID=default

# Optional: contact details shown in the footer (plain text only)
VITE_CONTACT_EMAIL=contact@example.com
VITE_CONTACT_PHONE=
